PORT=4173
HOST=0.0.0.0
LOG_LEVEL=INFO
DEV_MODE=false
DEV_HOST=127.0.0.1
DEV_PORT=4173
DATA_ROOT=./Data
# Set this to the persistent chunks folder mounted on the GPU server in production.
AUDIT_ROOT=./data_chunks
PENDING_ROOT=./.studio/pending
EXTRACTED_ROOT=./.studio/extracted
PUBLISHED_ROOT=./.studio/published
VERSIONS_ROOT=./.studio/versions
AUTH_ENABLED=true
LDAP_HOST=ldap.company.local
LDAP_PORT=636
LDAP_BASE_DN=DC=company,DC=local
LDAP_BIND_DN=CN=service-account,OU=Service Accounts,DC=company,DC=local
LDAP_BIND_PASSWORD=replace-me
LDAP_USE_SSL=true
LDAP_GROUP_DN=CN=Steps-Studio,OU=Groups,DC=company,DC=local
# Optional; this is the Active Directory default used by the application.
LDAP_USER_FILTER=(sAMAccountName={{username}})
# Main admins can access both areas, all history, and Advanced JSON.
ADMIN_USERS=halasw,lojaina
# Retail operators can access only Retail products and their own history.
RETAIL_USERS=khaledsh
# Steps operators can access only Steps & workflows and their own history.
STEPS_USERS=raneems,lubianaa
# Optional extra approvers. The three groups above already receive their required action permissions.
APPROVER_USERS=
SESSION_HOURS=8
# Set true only when served over HTTPS.
COOKIE_SECURE=false
# Keep true for LDAPS. Only set false temporarily when diagnosing a private CA.
LDAP_TLS_REJECT_UNAUTHORIZED=true
# Mount the NFS export on this machine, then point this at the mounted directory.
# Never expose the NFS share directly to browser clients.
NFS_PUBLISH_ROOT=
# Milvus is optional. Publishing still writes an outbox document when disabled.
MILVUS_HOST=10.0.30.51
MILVUS_PORT=19530
MILVUS_TOKEN=
MILVUS_SYNC_ENABLED=true
STEPS_COLLECTION=steps_workflow
RETAIL_COLLECTION=retail_products
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu
# Optional custom mapping. RETAIL_USERS, STEPS_USERS, and ADMIN_USERS take precedence when set.
USER_ROLES_JSON={}
# Development only, used when LDAP_HOST is empty. Never commit real passwords.
DEV_USERS_JSON={}
