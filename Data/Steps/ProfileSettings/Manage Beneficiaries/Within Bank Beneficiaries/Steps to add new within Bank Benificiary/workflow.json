      "fields": [
        "IBAN / Account Number",
        "Nickname",
        "Name"
      ],
      "image": "step_3.png"
    },
    {
      "step": 4,
      "text": "Review the entered details.",
      "options": [
        "Go back and edit details",
        "Add a profile image for the beneficiary"
      ],
      "actions": [
        "Tap 'Confirm' to complete the request"
      ],
      "image": "step_4.png"
    }
  ]
}