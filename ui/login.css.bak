.login-page{min-height:100vh;background:#0d352a}.login-shell{display:grid;grid-template-columns:1.1fr .9fr;min-height:100vh;height:auto}.login-copy{padding:10vh 9vw;color:#dcebe5;display:flex;flex-direction:column;justify-content:center;background:radial-gradient(circle at 10% 20%,#21614e 0,transparent 42%),linear-gradient(145deg,#123b30,#082820)}.login-copy .mark{margin-bottom:55px;background:#e9f5ef;color:#0c6b4f}.login-copy .eyebrow{color:#8ec4b0}.login-copy h1{font:500 clamp(38px,5vw,66px)/1.04 Georgia,serif;max-width:700px;margin:16px 0 24px;color:#fff}.login-copy>p:not(.eyebrow){font-size:17px;max-width:570px;color:#b8d0c7}.proof{display:flex;gap:24px;margin-top:50px;color:#a9c8bd}.login-card{background:#f7f9f8;display:grid;place-items:center;padding:30px}.login-card form{width:min(390px,100%);background:#fff;padding:38px;border:1px solid #dae4df;border-radius:16px;box-shadow:0 20px 50px #061b1418}.login-card h2{font-size:28px;margin:6px 0}.login-card label{margin-top:22px}.login-card button{width:100%;margin-top:25px;padding:12px}.login-card small{display:block;text-align:center;color:#83908a;margin-top:18px}.login-error{background:#fdecea;color:#a83c32;padding:10px;border-radius:7px}.login-page main{height:auto}@media(max-width:800px){.login-shell{grid-template-columns:1fr}.login-copy{display:none}.login-card{min-height:100vh}}
